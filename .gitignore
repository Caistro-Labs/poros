# Logs
# LaTeX build byproducts
*.aux
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.log
# a validation run's log is its receipt (docs/validation/*/README.md names them)
!docs/validation/**/*.log
events.jsonl
# a validation run's per-step file, job output and run folder are receipts too (weights stay ignored)
!docs/validation/**/events.jsonl
!docs/validation/**/*.out
!docs/validation/**/runs/

# Jupyter
.ipynb_checkpoints/

# arXiv build outputs (regeneratable)
paper/poros-arxiv-submission.tar.gz
paper/src/main.pdf
